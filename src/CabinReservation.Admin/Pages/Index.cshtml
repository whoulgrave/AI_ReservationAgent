@page
@model IndexModel
@{ ViewData["Title"] = "Calendar"; }
<h1>Cabin calendar</h1><form method="get"><input asp-for="From" type="date"/><input asp-for="To" type="date"/><button>View</button></form>
<table><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody>@foreach(var day in Model.Days){<tr><td>@day.Date</td><td>@day.Status</td></tr>}</tbody></table>
