{
  "ConnectionStrings": {
    "CabinDatabase": "Data Source=data/cabin.db;Cache=Shared;Foreign Keys=True"
  },
  "ReservationPolicy": {
    "CabinTimeZoneId": "America/New_York",
    "MaximumActiveNightsPerMember": 2,
    "CancellationCutoffLocalTime": "12:00:00",
    "CancellationDaysBeforeStay": 1,
    "WaitListOfferMinutes": 240,
    "WorkerIntervalSeconds": 60
  },
  "ApiSecurity": {
    "ApiKey": "CHANGE-ME-IN-PRODUCTION"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
